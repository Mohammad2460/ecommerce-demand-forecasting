{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "streamlit", "run", "src/ecom/dashboard/app.py", "--server.port", "8501"],
      "port": 8501
    },
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "uvicorn", "ecom.api.main:app", "--app-dir", "src", "--port", "8000"],
      "port": 8000
    }
  ]
}
